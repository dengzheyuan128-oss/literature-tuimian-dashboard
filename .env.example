# Supabase 配置
# 从 Supabase Dashboard -> Settings -> API 获取
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 百度统计配置（可选）
# 从百度统计 https://tongji.baidu.com 获取
# 新增站点后，在“代码获取”中找到 hm.js? 后面的字符串
VITE_BAIDU_SITE_ID=your-baidu-site-id-here

# GLM API Key（管理员 AI 提取功能，可选）
# 从智谱开放平台 https://open.bigmodel.cn 获取
VITE_GLM_API_KEY=your-glm-api-key-here

# 管理员邮箱列表（逗号分隔）
# 只有这些邮箱的用户才能访问 /admin/extract 页面
VITE_ADMIN_EMAILS=admin@example.com

# 注意
# 1. 复制此文件为 .env.local 并填入真实值
# 2. .env.local 不会被提交到 Git
# 3. 在 Vercel 部署时，需要在 Environment Variables 中设置这些值
# 4. `SUPABASE_SERVICE_ROLE_KEY` 仅用于本地或受控脚本导入，不能暴露到前端
